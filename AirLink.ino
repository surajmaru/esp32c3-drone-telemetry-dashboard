/*
 * LOGICSURU AirLink  (single-file Arduino IDE version)
 * ESP32-C3 SuperMini  <->  BotWing F405 (Betaflight, MSP over UART)
 *
 * Arduino IDE setup:
 *   1. Install ESP32 board package (Espressif) via Boards Manager
 *   2. Library Manager -> install "WebSockets" by Markus Sattler
 *   3. Tools -> Board: "ESP32C3 Dev Module"
 *   4. Tools -> USB CDC On Boot: "Enabled"   (needed for Serial Monitor over USB)
 *   5. Upload. If upload fails, hold BOOT, tap RESET, release BOOT, then upload.
 *
 * Wiring (cross TX/RX):
 *   C3 GPIO20 (RX)  <-  FC TX6
 *   C3 GPIO21 (TX)  ->  FC RX6
 *   GND             --  GND
 *
 * Wi-Fi: "LOGICSURU-AirLink" / "airlink123"  ->  open http://192.168.4.1/
 *
 * Set SIMULATE to 1 to test the page with fake data and no FC attached.
 */

#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include "esp_wifi.h"
#include "esp_system.h"

// ---------------- Config ----------------
#define SIMULATE 0   // 1 = fake data (bench test), 0 = read real FC over UART
#define LOW_TX_POWER 0   // set 1 if the Wi-Fi keeps dropping or restarting (shorter range)

static const char *AP_SSID = "LOGICSURU-AirLink";
static const char *AP_PASS = "airlink123";   // min 8 chars
static const int   AP_CHANNEL = 1;

static const int      FC_RX_PIN = 20;        // C3 RX  <- FC TX6
static const int      FC_TX_PIN = 21;        // C3 TX  -> FC RX6
static const uint32_t FC_BAUD   = 115200;    // must match UART6 MSP baud in Betaflight

static const uint32_t SEND_INTERVAL_MS = 100;   // websocket push rate (10 Hz)
static const uint32_t MSP_REQ_GAP_MS   = 20;    // min gap between MSP requests
static const uint32_t MSP_TIMEOUT_MS   = 80;    // give up waiting for a reply
static const uint32_t FC_LOST_MS       = 1500;  // no valid MSP reply for this long = FC link lost

// MSP v1 command IDs
#define MSP_STATUS    101
#define MSP_RC        105
#define MSP_RAW_GPS   106
#define MSP_ATTITUDE  108
#define MSP_ALTITUDE  109
#define MSP_ANALOG    110

HardwareSerial FCSerial(1);
WebServer server(80);
WebSocketsServer ws(81);

